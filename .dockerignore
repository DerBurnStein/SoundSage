# SoundSage — files excluded from the Cloud Build / Cloud Run upload.
# Mirrors .gitignore in spirit but is stricter — anything not needed to
# install deps + run `next build` inside the container should be excluded
# so the upload stays small and deploys finish in seconds, not minutes.

# ─── Build outputs (regenerated by `next build` inside the container) ───────
.next
out
dist

# ─── Dependencies (re-installed inside the container from package*.json) ───
node_modules

# ─── Secrets — must NEVER ship into a container image ──────────────────────
.env
.env.*
!.env.example

# ─── Local dev artefacts ────────────────────────────────────────────────────
.vscode
.idea
.vs
*.log
npm-debug.log*
*.pid
*.seed
*.pid.lock
.DS_Store
Thumbs.db

# ─── Test runner state ──────────────────────────────────────────────────────
playwright-report
test-results
coverage
.nyc_output
lighthouse-overview.json

# Playwright browsers — downloaded into a user-scoped cache, not the project.
# But guard against an alternate local install just in case.
ms-playwright
.playwright

# ─── Git + meta — repo history isn't needed in the runtime image ───────────
.git
.gitignore
.gitattributes

# ─── CI / Cloud config that shouldn't be inside the container ──────────────
.github
cloudbuild.yaml

# ─── Documentation + planning docs ─────────────────────────────────────────
# Don't bundle 600-line spec docs into the runtime image. README stays so
# Cloud Run shows it on the service page.
*.md
!README.md

# ─── Generated Sentry artefacts ────────────────────────────────────────────
.sentryclirc

# ─── Editor swap files ─────────────────────────────────────────────────────
*.swp
*.swo

# ─── Local Prisma shadow DB artefacts (regenerated during build) ───────────
prisma/migrations/.shadow

# ─── Claude Code local state ───────────────────────────────────────────────
.claude
