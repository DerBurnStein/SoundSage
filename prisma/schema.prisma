generator client {
  provider      = "prisma-client-js"
  // Cloud Run runs on Alpine (musl libc); local dev runs on Windows or
  // Linux (glibc). Prisma needs the right native engine binary for each.
  // Without `linux-musl-openssl-3.0.x` the runtime can't load
  // libquery_engine-linux-musl.so.node and every DB call throws.
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── App user (keyed by NextAuth-generated cuid) ─────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  prefs         Json      @default("{\"theme\":\"paper\",\"density\":\"regular\"}")
  timezone      String    @default("UTC")
  createdAt     DateTime  @default(now())

  // First-login data-source picker. NULL until the user dismisses or completes
  // the onboarding modal. `onboardingChoice` records which path they took
  // ("esh" | "lastfm" | "synthetic" | "skip") so we can surface the right
  // follow-up CTA in Settings ("Upload your ESH ZIP when it arrives").
  onboardingCompletedAt DateTime?
  onboardingChoice      String?

  accounts        Account[]
  sessions        Session[]
  spotify         SpotifyAccount?
  events          ListeningEvent[]
  topTrackSnaps   TopTrackSnapshot[]
  topArtistSnaps  TopArtistSnapshot[]

  @@map("users")
}

// ─── NextAuth tables (managed by @auth/prisma-adapter) ───────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Spotify connection (1:1 with User, optional until connected) ─────────────

model SpotifyAccount {
  userId         String   @id
  spotifyUserId  String   @unique
  displayName    String? // Spotify-side display name (separate from Google's User.name)
  imageUrl       String? // Spotify avatar URL — refreshed on connect + opportunistically
  accessToken    String   @db.Text // AES-256-GCM ciphertext (base64-encoded)
  refreshToken   String   @db.Text // AES-256-GCM ciphertext (base64-encoded)
  expiresAt      DateTime
  scopes         String
  cursor         DateTime? // ingestion high-water mark (last played_at synced)
  lastSyncAt     DateTime?
  failureCount   Int      @default(0)
  needsReconnect Boolean  @default(false)
  connectedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("spotify_accounts")
}

// ─── Track metadata cache ─────────────────────────────────────────────────────

model Track {
  id          String   @id // Spotify track ID (no URI prefix — just the bare ID)
  name        String
  artistNames String[]
  artistIds   String[] // parallel to artistNames; references Artist.id
  albumName   String?
  albumId     String?
  imageUrl    String?
  durationMs  Int?
  updatedAt   DateTime @updatedAt

  topSnapshots TopTrackSnapshot[]

  @@map("tracks")
}

// ─── Artist metadata cache (genres backfilled async) ──────────────────────────

model Artist {
  id           String   @id // Spotify artist ID
  name         String
  imageUrl     String?
  genres       String[] // empty until backfill job populates it
  genresSynced Boolean  @default(false)
  updatedAt    DateTime @updatedAt

  topSnapshots TopArtistSnapshot[]

  @@index([genresSynced])
  @@map("artists")
}

// ─── Top-items snapshots (Spotify-computed aggregates) ───────────────────────
//
// Spotify's /v1/me/top/{tracks,artists}?time_range={short,medium,long}_term
// endpoints return server-computed top-50 lists across rolling 4-week, 6-month,
// and ~12-month windows. These snapshots populate Tracks/Artists/Patterns tabs
// instantly on first connect — without them, a brand-new user sees empty
// charts until raw `recently_played` events accumulate over weeks.
//
// Refreshed at connect time and on a periodic schedule (weekly is plenty —
// rankings shift slowly). Dashboard queries read from these tables when the
// user has too few raw events to compute their own ranks.

model TopTrackSnapshot {
  id         BigInt   @id @default(autoincrement())
  userId     String
  // 'short_term' | 'medium_term' | 'long_term' — matches Spotify's API param.
  range      String
  rank       Int      // 1..50, lower = more played
  trackId    String   // FK to Track.id
  capturedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id])

  // One row per (user, range, rank). A new bootstrap deletes the prior set
  // for that (user, range) before inserting the fresh top-50.
  @@unique([userId, range, rank])
  @@index([userId, range])
  @@map("top_track_snapshots")
}

model TopArtistSnapshot {
  id         BigInt   @id @default(autoincrement())
  userId     String
  range      String   // same vocabulary as TopTrackSnapshot.range
  rank       Int      // 1..50
  artistId   String   // FK to Artist.id
  capturedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id])

  @@unique([userId, range, rank])
  @@index([userId, range])
  @@map("top_artist_snapshots")
}

// ─── Listening events (core data table) ──────────────────────────────────────

model ListeningEvent {
  id       BigInt   @id @default(autoincrement())
  userId   String
  trackId  String
  playedAt DateTime
  msPlayed Int?
  source   String   @default("recently_played") // 'recently_played' | 'extended_history'

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId, playedAt]) // dedup key — skipDuplicates relies on this
  @@index([userId, playedAt(sort: Desc)]) // primary query path for all stats
  @@map("listening_events")
}
