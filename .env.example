# =============================================================================
# SoundSage — Environment Variables
# Copy this file to .env.local and fill in all values before running locally.
# In production, all values are stored in GCP Secret Manager.
# =============================================================================

# --- Database ---
# Local: matches docker-compose.yml defaults
# Production: Cloud SQL connection string via Unix socket
#   postgresql://USER:PASSWORD@localhost/soundsage?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/soundsage

# --- Redis ---
# Local: matches docker-compose.yml
# Production: Upstash Redis URL (rediss://...)
REDIS_URL=redis://localhost:6379

# --- NextAuth ---
NEXTAUTH_URL=http://127.0.0.1:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# --- Google OAuth ---
# GCP Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Redirect URI to add: http://127.0.0.1:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Spotify OAuth ---
# developer.spotify.com → Your app → Settings
# Redirect URI to add: http://127.0.0.1:3000/auth/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/auth/spotify/callback

# --- Token Encryption ---
# AES-256-GCM key for encrypting Spotify tokens at rest.
# Generate with: openssl rand -base64 32
# NEVER commit this value. Rotate via Secret Manager + re-encryption job.
TOKEN_ENCRYPTION_KEY=

# --- Sentry ---
# Settings → Client Keys → DSN
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=   # same value — needed for client-side error reporting

# --- Logging ---
# debug | info | warn | error
LOG_LEVEL=info

# --- GCP (only needed for deploy scripts, not app runtime) ---
GCP_PROJECT_ID=soundsage-staging
GCP_REGION=us-central1
